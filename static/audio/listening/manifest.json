   "role": "n",
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Question: Where do they go?"
  },
  "1099088a56d633a6": {
   "role": "f",
   "voice": "en-US-AriaNeural",
   "rate": "-10%",
   "text": "What do you have for breakfast, Sam?"
  },
  "6bbf6315c8e7095c": {
   "role": "m",
   "voice": "en-US-GuyNeural",
   "rate": "-10%",
   "text": "Some bread and an egg."
  },
  "4b5683626fe2a7ab": {
   "role": "n",
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Question: What does Sam have for breakfast?"
  },
  "2847e3c595973c45": {
   "role": "m",
   "voice": "en-US-GuyNeural",
