  "d4b26a6bf080d2de": {
   "role": "n",
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Can a dolphin fly?"
  },
  "ffe3efadcbc92d5d": {
   "role": "n",
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Does Jill walk to school?"
  },
  "a019812dd1fde6a7": {
   "role": "m",
   "voice": "en-US-GuyNeural",
   "rate": "-10%",
   "text": "This is your new classmate."
  },
  "c0f6cd442967944b": {
   "role": "f",
   "voice": "en-US-AriaNeural",
   "rate": "-10%",
   "text": "What's her name?"
  },
  "0833059e6a4e204b": {
   "role": "m",
   "voice": "en-US-GuyNeural",
   "rate": "-10%",
   "text": "Her name is Jill."
  },
  "244f54f40f07e9ff": {
   "role": "n",
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Question: What is the girl's name?"
  },
  "4640a7d3e5d1c496": {
   "role": "f",
   "voice": "en-US-AriaNeural",
   "rate": "-10%",
   "text": "Can Peter swim?"
  },
  "709fe4ea1899a0d0": {
   "role": "m",
   "voice": "en-US-GuyNeural",
   "rate": "-10%",
   "text": "Yes, he can swim well."
  },
  "cc2e91bdeb7b1f4f": {
   "role": "n",
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Question: What can Peter do?"
  },
  "a5ead942558afe01": {
   "role": "m",
   "voice": "en-US-GuyNeural",
   "rate": "-10%",
   "text": "Can an elephant fly?"
  },
  "2a13841506bf247e": {
   "role": "f",
   "voice": "en-US-AriaNeural",
   "rate": "-10%",
   "text": "No, it can't. But it has four legs."
  },
  "ca6b3ba8edf99ef7": {
   "role": "n",
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Question: What animal do they talk about?"
  },
  "733377d4fc721c34": {
   "role": "f",
   "voice": "en-US-AriaNeural",
   "rate": "-10%",
   "text": "Does Alice like reading?"
  },
  "c6f447fcd5bf2df0": {
   "role": "m",
   "voice": "en-US-GuyNeural",
   "rate": "-10%",
   "text": "No. She likes dancing."
  },
  "33917acc13d99c1d": {
   "role": "n",
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Question: What does Alice like?"
  },
  "655bb27cedf127bc": {
   "role": "n",
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "This is my friend Jill. She is ten years old. Her student number is sixteen. She lives near school and walks to school every day. She likes reading and dancing. She can play basketball well. She has a basketball in her bag."
  }
