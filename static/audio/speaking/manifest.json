   "text": "Mr Zhong is a teacher."
  },
  "797870cb84e1b466": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Is Miss Li a teacher?"
  },
  "61a41ce9a10a33af": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Who is Shenshen's mum?"
  },
  "f22b8e5f5b47b2d7": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "I win!"
  },
  "94512795dd4bc4c3": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Please be quiet."
  },
  "562722908ed1f6f4": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "May I use your red pencil?"
  },
  "1ac2dd9e11ae0565": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Here you are."
  },
  "7dfcf64891a30fc4": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Open your books, please."
  },
  "fb1f34c12285fba1": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Read the story with your partner."
  },
  "f76aab841666d62c": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "How do you spell book?"
  },
  "86b2d505bc8bc1a5": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "B-o-o-k."
  },
  "959e8a7913ba6bb8": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Don't be afraid!"
  },
  "88aa57a3b9962ead": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Have a try!"
  },
  "6dd7a6e871ac8371": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "This is my plan for English study."
  },
  "dd8e48944e5a4898": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Well done! It's a good plan!"
  },
  "6e7444c0fe02c89c": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Your friend is afraid. What do you say?"
  },
  "1644e0395e16534d": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Twenty, twenty-one, twenty-two."
  },
  "e7e9a7bf843a0dd1": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Twenty-three, twenty-four, twenty-five."
  },
  "162d91f45360a4ad": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Twenty-six, twenty-seven, twenty-eight, twenty-nine."
  },
  "94c0cf022ba5acca": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Thirty, forty, fifty."
  },
  "a50c2accaa9c2122": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Sixty, seventy, eighty, ninety."
  },
  "52f35110612ac3d7": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "One hundred."
  },
  "f95520b823ae084e": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "There are twenty-four girls. How many girls are there?"
  },
  "76556d35e78871ea": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "There are twenty-six boys. How many boys are there?"
  },
  "48f39ab3c79b44f5": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Monday, Tuesday, Wednesday."
  },
  "b2887c5f731b321f": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Thursday, Friday, Saturday, Sunday."
  },
  "6d32c2d57336bc4a": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Tuesday is after Monday."
  },
  "7e09e4807567d089": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Sunday is after Saturday."
  },
  "d50fa3d49f94e716": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "My favourite day is Sunday."
  },
  "847bb7e12cf1128d": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "On Tuesday, read the story with your partner."
  },
  "fd818df19483f9ff": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What day is after Tuesday?"
  },
  "8174fedc9684c9eb": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What day is after Saturday?"
  },
  "c9e8a0a4bb769dd6": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "I like my school."
  },
  "da08866b4f26b49e": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "It is lovely and cool."
  },
  "8601cccd86211ef5": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "In the classroom I study."
  },
  "8c78a6bbed7d1b2d": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "On the sports field I play."
  },
  "eabbad07f9b3dfd6": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "In the hall I sing for all."
  },
  "d3daf611384e1428": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "The library is the best of all."
  },
  "54da626f7003614b": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Where do you study?"
  },
  "f9fdb2b26d1dd2a1": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Where do you play?"
  },
  "8866fc1044ed0d68": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Shall we begin with our project?"
  },
  "5e8375cf53db85df": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Sure. But where are James and Xiaopu?"
  },
  "c4919fe929d5322f": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "James is in the library."
  },
  "271de88dbe6bacfc": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Xiaopu is likely on the sports field."
  },
  "7a832a0bb41a3b1a": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "How about the computer room?"
  },
  "151f030314fb1b03": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Sure. Let us meet there then."
  },
  "274fc31b1de44562": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Where is James?"
  },
  "7f66750cb0edcd1f": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Where will the group meet?"
  },
  "bfad290748f3076e": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "The classroom has no computers."
  },
  "7f5bf11aabb79b07": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "The classroom does not have any computers."
  },
  "0aa1d69f25a1b003": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "The computer room is on the ground floor."
  },
  "57fb1c998a5d1432": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Let us meet in the computer room then."
  },
  "8301120a98d5a908": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Does the classroom have any computers?"
  },
  "4c66b7de6951738d": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Where will Minmin's group meet?"
  },
  "2ce8e03821573085": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "All the school buildings are made of bamboo."
  },
  "2c463725512726e2": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "These bamboo buildings have no walls."
  },
  "9d7b4716b9dad013": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "They do not have any walls."
  },
  "5eb335788589bf85": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "They look like big umbrellas."
  },
  "4d64607cc52b2f59": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Each building has three floors."
  },
  "6cd5da56e3a6cec7": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Students learn and play in bamboo classrooms."
  },
  "4bd808763db66cf0": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What are the school buildings made of?"
  },
  "c7cf8a448890d89e": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What do the buildings look like?"
  },
  "62e0503eed2cf61f": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "I like the library in my school best."
  },
  "96d58f0f833499f0": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "It is on the ground floor."
  },
  "841540bc607c9d51": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "It is very special and looks like a boat."
  },
  "856353155ca3ad87": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "The room does not have any chairs or desks."
  },
  "550844264627f04c": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "In the library, I read many interesting books."
  },
  "d0c652ff15618d64": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "I like my school because every place is special."
  },
  "a898721299d6b2fb": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Where is the library?"
  },
  "bc97b769a6288393": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What do you do in the library?"
  },
  "49da074def3be74c": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Here are my lovely classmates."
  },
  "aec10f1629792070": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "They are different but all great."
  },
  "34b00d56ecab3dcb": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "This classmate is helpful."
  },
  "4447a41e1d72242c": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "My classmate is interesting."
  },
  "3c0e31c670e7b5ae": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "She is friendly and lovely."
  },
  "e6e15cc7e1ef4094": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Let us play a guessing game about classmates."
  },
  "7785cd83101039cd": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What are your classmates like?"
  },
  "b28a10e0e10113e4": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Is your classmate helpful?"
  },
  "9b3809e3b6cb775d": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Shenshen wants to be a writer."
  },
  "5aa7b461d2cb6e65": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Xiaojiang wants to be a painter."
  },
  "afb2e1dcb191b01c": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "They often share works with each other."
  },
  "bdf63205b484b1fd": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Minmin is good at football."
  },
  "9f328809c42186c4": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Xiaopu is good at basketball."
  },
  "9a77195886ba6fa4": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Yaoyao often helps James with his Chinese."
  },
  "094f24c077614078": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Who is good at basketball?"
  },
  "4512ca87a339cd60": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What does Shenshen want to be?"
  },
  "73d074eae25aed1e": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "He has a lovely smile and many friends."
  },
  "51caabf944810577": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "He often tells interesting stories."
  },
  "6f62dde02bf72b6c": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "He always helps teachers clean the blackboard."
  },
  "e93f883bea7b072e": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "James often helps other students learn English."
  },
  "ea19f47201468ab9": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Wenwen always helps his little brother clean the room."
  },
  "64f26c659adc3432": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "It is you, James. You are helpful too."
  },
  "8a21433d2ab1aad8": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Who always helps teachers clean the blackboard?"
  },
  "4974da34c75edbeb": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Why is James helpful?"
  },
  "1b4b84ee455c8b7c": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "The classmates are skipping with a long rope."
  },
  "35f772e46fb1ef4a": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Take it easy. Wait and jump over it."
  },
  "1eb9eb18b2faf38a": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Minmin shows James how to jump."
  },
  "43ad00c4da76a2cc": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Come on, James! You can do it!"
  },
  "e958449276d59c16": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Shenshen and Xiaojiang turn the rope more slowly."
  },
  "a41ae96e752d0759": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "James is happy and excited at the end."
  },
  "18596c3bcc679045": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Who shows James how to jump?"
  },
  "808dd0db96267415": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What is the result of the story?"
  },
  "5948f5f3f97b1764": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "My classmates are different but all great."
  },
  "0c315a9e37a2f38e": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "She is friendly and helpful."
  },
  "fe38c8ad0ac4dce0": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "She often helps me draw."
  },
  "e3a4569d8b0a8f19": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "She is good at painting pictures."
  },
  "05cffe19a0ea9f45": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "She wants to be a painter."
  },
  "83c1274e3a2aa57a": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "The problem has a solution, and the result is great."
  },
  "37d8fd3aa02f6728": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Who often helps James with his Chinese?"
  },
  "326d3e8b09f2c007": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Can you describe a helpful classmate?"
  }
