{
 "fragments": {
  "93830c8a0cd44c8f": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "I have a little cat."
  },
  "6e18574d58fee75a": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "The panda is black and white."
  },
  "52a32431e6bedcd3": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "I can see five birds."
  },
  "81bc484fc114bf7c": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "It's a rabbit."
  },
  "cbe67e00e238a236": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "How many cats can you see?"
  },
  "012347eddc300faf": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "I like pandas."
  },
  "35894030823c591b": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Is this a tiger?"
  },
  "d24449749f119d0f": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "The apple tastes sweet."
  },
  "a397e8711ba2556c": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "The orange tastes sour."
  },
  "ad917173a308fa1c": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Smell the flower. It smells nice."
  },
  "3694ffaa0f4ef0e7": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "The bread is soft."
  },
  "83f41e22e5b8de81": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "May I have some milk?"
  },
  "3292a7468b78bb21": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "I like eating cakes."
  },
  "a749ecdaa755c164": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "How does the cake taste?"
  },
  "5f179c8b33ff4a5c": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Do you like apples?"
  },
  "e7fc0601dd278783": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "I like flying kites."
  },
  "52122b1e293ac03f": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "My bag is big."
  },
  "7936257d38c31de2": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "The ball is under the desk."
  },
  "aa48feaf262770f4": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "I can ride a bicycle."
  },
  "8a335c850baf35dd": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Can you skip rope?"
  },
  "4c227b45506a9c71": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "I play football on Sunday."
  },
  "7ae2a8f7862ba14d": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Can you swim?"
  },
  "610c87d959a7b5e7": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Where is the pencil?"
  },
  "5c4fa528049ddd80": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "The tiger is big."
  },
  "40b9b32f2fb4b155": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "I have an egg and some milk."
  },
  "1a20c375d9fb0cbe": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "My kite is red and yellow."
  },
  "4316544cd6202fc7": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "The soup tastes salty."
  },
  "8634fe7ed6aeacdc": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "I go to the park with my mother."
  },
  "95df27734af6c7fc": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What a happy day!"
  },
  "71dceeb031d9b761": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "How does the orange taste?"
  },
  "4e856b42a9552978": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Do you like swimming?"
  },
  "e560ac2ca363e5ef": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Happy Children's Day!"
  },
  "a05c68df7a655235": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "This is a present for you."
  },
  "03baf6e93ec2f616": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Look at that bird over there."
  },
  "b7eb7ecf318086fa": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What colour is the bird?"
  },
  "d245ffb13c524671": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Can you draw a cat?"
  },
  "8ac5daeb7bc4e6f8": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Good morning, Miss Fang."
  },
  "e181b1936f1b683e": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "This is my friend."
  },
  "d19ade21bfa122a3": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "His name is Paul."
  },
  "0e0af6417c6e2582": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Her name is Sally."
  },
  "4b52f8ca4e8d5397": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "She's twelve."
  },
  "36a43e229438c89c": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Her student number is sixteen."
  },
  "d1288221bb7dcc0e": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What's his name?"
  },
  "5cb6ccf9d371194d": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What's her student number?"
  },
  "262e09557b2c5155": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "We have a new classmate, Jill."
  },
  "95f941e992fa7d3f": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "She's ten years old."
  },
  "5a875560746afeb2": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "She lives near our school."
  },
  "b059d307f82538ed": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "She walks to school every day."
  },
  "2ba12e64102f23ec": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "She likes reading and dancing."
  },
  "9a7c87472f5792ab": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "She can play basketball well."
  },
  "543da57b9839fac6": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What does Jill like?"
  },
  "606bb91d4bd2bf56": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What can Jill do?"
  },
  "774a51c794372207": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "I can draw."
  },
  "4d66ec9aa5305205": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "I can read."
  },
  "147d4e1894f7f4f5": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "I can write."
  },
  "1cfa0926b450fed6": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "I can swim."
  },
  "859b7f9f606a9064": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What can you do?"
  },
  "e85b06c35501bb97": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "I can jump and run."
  },
  "39e2d811e65fc3a9": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Can you write?"
  },
  "c44cc21db9413670": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Can she swim?"
  },
  "48966555297321fd": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Yes, she can."
  },
  "89af93250edf6d8c": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Can he fly?"
  },
  "a84717f825a94638": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "No, he can't."
  },
  "872f06c4c7af5c1b": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "A bird can fly high."
  },
  "ecd4fee8230d2449": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "A dolphin can swim well."
  },
  "4b04cff9c65e7e0a": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Can a bird fly?"
  },
  "ea1f4ac2e927efec": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Can a dolphin run fast?"
  },
  "8733ca1aba747983": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "This is my friend Jill."
  },
  "1bfb89d2b2effe22": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Her name is Jill."
  },
  "ed5afd0ac9e18649": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What can your friend do?"
  },
  "9ba0133179e519cd": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What does your friend like?"
  }
