   "text": "He's eleven years old."
  },
  "332970f962e536b8": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "He can swim very fast."
  },
  "778ada28302be715": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "He's my uncle. He can dive."
  },
  "e835f2a6668e54df": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Who is Wang Rong?"
  },
  "d9d47dde58c882cf": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What can Wang Rong do?"
  },
  "4147f353b993ce10": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Hello, Grandpa and Grandma!"
  },
  "a304afed5da468f9": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Come in, please."
  },
  "d917499cfe1df0e6": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Let's have some mooncakes."
  },
  "311b589b9fd17fa5": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Watch the beautiful moon in the garden."
  },
  "828da46a0265faf8": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "I have a riddle for you."
  },
  "950b422f152b36d2": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "It's big and bright in the sky."
  },
  "869450a3f4680484": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What is it?"
  },
  "b5add6d74107a469": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Where is the moon?"
  },
  "61cd4cba381f5dc0": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "That's my cousin, Bess."
  },
  "ebb8052f77d32b2b": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "She's in the short black dress."
  },
  "7233e9393740563f": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "That's my aunt in the long red skirt."
  },
  "ba6b14103f28c37c": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "That's my uncle in the bright green shirt."
  },
  "1a50659c52f4fab7": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Wash the fish."
  },
  "22102a41caa246d3": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Who is Bess?"
  },
  "7d8f7cef858f878d": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Look at the fire."
  },
  "c5bea9444f901dbf": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Call the fire station."
  },
  "62c295cf24bcc7a4": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "One, one, nine!"
  },
  "7be2dc37eea482a0": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Bring the fire engine."
  },
  "a444681999ab4289": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "The brave firefighters are here."
  },
  "a8098e057177efc9": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Put out the fire!"
  },
  "712110f6337f171e": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What can you see?"
  },
  "244190fee59a2534": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Who can put out the fire?"
  },
  "3e1736b24f430a7f": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What does your father do?"
  },
  "7ce29dfb1b31344c": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "He is a firefighter."
  },
  "fadaa3f8f3c656bc": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What does your mother do?"
  },
  "53f9eec5b2237195": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "She is a nurse."
  },
  "c147e2e0f3b5eb4f": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "He is a teacher."
  },
  "fbc98c4003f434fd": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "She is a doctor."
  },
  "f34fe4d474c12eea": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What does Jill's father do?"
  },
  "19a2f1f43034763a": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What does Jill's mother do?"
  },
  "fdc2f145d930d60b": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What does Mrs White do?"
  },
  "7812eb891e4f6904": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Is she a nurse?"
  },
  "c59c78cb593b4bc0": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "No, she isn't."
  },
  "03164513a2eed743": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "She is a teacher."
  },
  "71181b76814efa02": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Is he a police officer?"
  },
  "382f2f96cf128a55": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Yes, he is."
  },
  "097b53c35d56c24d": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Is Mrs White a nurse?"
  },
  "b8085d47f7519fc9": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "This is a fire station."
  },
  "0eed8e8379c15fee": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "You're welcome."
  },
  "b815b7ed54ef8522": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "This is a fire engine."
  },
  "91aedc900ad4f797": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Fire is dangerous."
  },
  "f595b42d668b23c4": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "I'm a firefighter. I can help people."
  },
  "9511397d68fcf706": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Don't play with fire, children."
  },
  "2d0db475257fb2c3": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Are you afraid, Mr Xu?"
  },
  "04f6be69e57ed6b5": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Does Mr Xu like his job?"
  },
  "39508160dd8028bf": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "The princess has a dream."
  },
  "2798c077c9df3d3a": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "She buys a pretty dress."
  },
  "32e8ea3284be9db3": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "She likes the dress."
  },
  "b401276cdab21b83": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "She doesn't care about the price."
  },
  "d8b07def1510a947": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What does the princess buy?"
  },
  "af5d584bc9263b5e": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "I have a friend."
  },
  "65dd08fcf753e8d4": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "His name's Tom."
  },
  "a25e0f7ad8898775": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "He's tall and thin."
  },
  "703700a7c8177524": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "He has a green T-shirt."
  },
  "fcdb9f40164f63f7": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Peter can ride a bicycle."
  },
  "32de833360f2e70b": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Sally can fly a kite."
  },
  "ce0e346fdba1eec7": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What can Tom do?"
  },
  "6fe39ed9fecd26fd": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Who has a pink skirt?"
  },
  "8b410f7caf4f92f2": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "This is a coat."
  },
  "af76655f9eef0c60": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "This is a blouse."
  },
  "ce1d47778a62afe7": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "She has a purple skirt."
  },
  "1ffbd1c9ce8e50ca": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "These are jeans."
  },
  "e9f0994a1c5903c4": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "These are shorts."
  },
  "bc53116a83dff44f": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What does she have?"
  },
  "c9cf7bb9ff783c5f": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What does he have?"
  },
  "bbdeb15ae13d99f4": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "This is a lion."
  },
  "2667eec4f6485a2c": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "It is big and strong."
  },
  "508e0dc530f2ad16": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "It has big teeth."
  },
  "835925af0343400c": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "This is a mouse."
  },
  "8630f4710084198b": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "It has small but sharp teeth."
  },
  "e3c31f1d6c4a23b5": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "The mouse can bite."
  },
  "25b965ad1f2143a0": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Who is in the net?"
  },
  "67045f91092a150f": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Can the mouse help the lion?"
  },
  "f4bffab61dedb9b8": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Short shorts today."
  },
  "13930a2763c01021": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "They're wearing short shorts today."
  },
  "203a5ce2832d0a56": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "The girls are wearing long jackets."
  },
  "a370e019bf2e1979": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "The girls are wearing white T-shirts."
  },
  "ed53eaedc6612ebb": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "The boys are wearing black T-shirts."
  },
  "d52d220c4166372a": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "The kids are wearing long socks."
  },
  "ae21e2c1ed9a17b6": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What are the girls wearing?"
  },
  "1ba3b1aef0f23290": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What are the boys wearing?"
  },
  "150c8c78b6e023cf": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "His name is Tom."
  },
  "1d7b36ab1a74ad52": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "He has a green T-shirt and he can skate."
  },
  "c5b39825c2c9bb7c": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Bryan likes ice cream."
  },
  "0687f054dd11f841": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "He likes bread too."
  },
  "dcc8701f0c3746a3": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "What does Tom have?"
  }
