  "7e87207a14e52a01": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Nanjing Road is in the centre of Shanghai."
  },
  "3d22170e125c8974": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "It is very busy."
  },
  "d8f3f4112143e380": {
   "voice": "en-US-AnaNeural",
   "rate": "-10%",
   "text": "Many people visit the shops."
