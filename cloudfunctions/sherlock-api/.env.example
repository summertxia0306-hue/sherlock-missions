# 仅配置于 CloudBase 云函数环境变量；不得提交真实值。
PARENT_PASSWORD_SCRYPT=
PARENT_SESSION_HMAC_KEY=
SESSION_TTL_SECONDS=7200
AUTH_MAX_FAILURES=5
AUTH_WINDOW_SECONDS=900
SPEAKING_INTERNAL_HMAC_KEY=
FORMAL_ENABLED=false
# dual | github-http-only | domestic-http-only | webapp-http-only | cloudbase-event-only
FORMAL_ENTRY_MODE=dual
SPEAKING_DIRECT_UPLOAD_TEST_ENABLED=false
